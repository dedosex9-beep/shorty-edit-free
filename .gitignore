const form = document.getElementById('reel-form');
const imageInput = document.getElementById('images');
const audioInput = document.getElementById('audio');
const fileList = document.getElementById('file-list');
const statusBox = document.getElementById('status-box');
const resultBox = document.getElementById('result-box');
const styleValue = document.getElementById('style-value');
const styleButtons = document.querySelectorAll('.style-btn');

styleButtons.forEach((button) => {
  button.addEventListener('click', () => {
    styleButtons.forEach((el) => el.classList.remove('active'));
    button.classList.add('active');
    styleValue.value = button.dataset.style;
  });
});

function renderFileList(files) {
  fileList.innerHTML = '';
  if (!files.length) {
    fileList.innerHTML = '<li>No files selected</li>';
    return;
  }

  files.forEach((file) => {
    const li = document.createElement('li');
    li.textContent = file.name;
    fileList.appendChild(li);
  });
}

imageInput.addEventListener('change', () => {
  renderFileList(Array.from(imageInput.files || []));
});

audioInput.addEventListener('change', () => {
  const audioFiles = Array.from(audioInput.files || []);
  if (audioFiles.length) {
    statusBox.className = 'status-box neutral';
    statusBox.innerHTML = '<strong>Audio ready</strong><p>' + audioFiles[0].name + '</p>';
  }
});

function setStatus(type, title, text) {
  statusBox.className = `status-box ${type}`;
  statusBox.innerHTML = `<strong>${title}</strong><p>${text}</p>`;
}

form.addEventListener('submit', async (event) => {
  event.preventDefault();

  const images = Array.from(imageInput.files || []);
  if (!images.length) {
    setStatus('error', 'No mockups selected', 'Please upload at least one image before creating your reel.');
    return;
  }

  const formData = new FormData();
  images.forEach((file) => formData.append('images', file));

  if (audioInput.files && audioInput.files[0]) {
    formData.append('audio', audioInput.files[0]);
  }

  formData.append('prompt', document.getElementById('prompt').value);
  formData.append('style', styleValue.value);

  setStatus('processing', 'Creating reel', 'Shorty is turning your mockups into a polished reel...');

  try {
    const response = await fetch('/api/create-reel', {
      method: 'POST',
      body: formData,
    });

    const data = await response.json();
    if (!response.ok || !data.ok) {
      throw new Error(data.error || 'Something went wrong.');
    }

    const jobId = data.jobId;
    let attempts = 0;
    const maxAttempts = 120;

    const poll = async () => {
      attempts += 1;
      const res = await fetch(`/api/jobs/${jobId}`);
      const job = await res.json();

      if (!job.ok) {
        throw new Error(job.error || 'Could not fetch job status.');
      }

      const current = job.job;
      setStatus(current.status === 'completed' ? 'success' : 'processing',
        current.status === 'completed' ? 'Reel ready' : 'Rendering reel',
        current.status === 'completed'
          ? 'Your reel is complete and ready to download.'
          : `Working... ${current.progress}%`);

      if (current.status === 'completed' && current.outputUrl) {
        resultBox.className = 'result-box';
        resultBox.innerHTML = `
          <video controls autoplay muted>
            <source src="${current.outputUrl}" type="video/mp4" />
          </video>
        `;
        return;
      }

      if (current.status === 'failed') {
        setStatus('error', 'Render failed', current.error || 'The reel could not be rendered.');
        return;
      }

      if (attempts < maxAttempts) {
        setTimeout(poll, 1500);
      } else {
        setStatus('error', 'Timed out', 'The render took too long. Please try again with fewer images.');
      }
    };

    await poll();
  } catch (error) {
    setStatus('error', 'Error', error.message || 'Failed to create reel.');
  }
});
